# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=your-temporary-or-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-here

# --- NVIDIA NIM (LLM) ---
NVIDIA_API_KEY=nvapi-your-key-here

# --- Optional: job search provider ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Email-based applications (SMTP) ---
# Gmail example: smtp.gmail.com, port 587, use an "app password"
# (myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Your Name

DATABASE_PATH=bot_data.db